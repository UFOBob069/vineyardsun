ADMIN_PASSWORD=choose-a-password
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Checkout (use matching test keys locally and live keys in production)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_AUTOMATIC_TAX=false
SHIPPING_RATE_CENTS=595

# Printful account-level token, pinned to the Vineyard Sun store
PRINTFUL_TOKEN=replace_me
PRINTFUL_STORE_ID=8579260
PRINTFUL_SHIPPING_METHOD=STANDARD

# Test Stripe payments never create real Printful orders by default.
